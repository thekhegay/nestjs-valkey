{
  "name": "nestjs-valkey",
  "version": "0.0.0",
  "description": "Valkey and Redis stores for @nestjs/locks and @nestjs/idempotency, on valkey-glide or ioredis, standalone or cluster",
  "license": "MIT",
  "author": "Roman Khegay <rk@garuna.dev> (https://garuna.dev)",
  "homepage": "https://github.com/thekhegay/nestjs-valkey#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thekhegay/nestjs-valkey.git"
  },
  "bugs": {
    "url": "https://github.com/thekhegay/nestjs-valkey/issues"
  },
  "keywords": [
    "nestjs",
    "valkey",
    "redis",
    "locks",
    "idempotency",
    "valkey-glide",
    "ioredis"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.26.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locks": {
      "types": "./dist/locks/index.d.ts",
      "default": "./dist/locks/index.js"
    },
    "./idempotency": {
      "types": "./dist/idempotency/index.d.ts",
      "default": "./dist/idempotency/index.js"
    },
    "./glide": {
      "types": "./dist/glide/index.d.ts",
      "default": "./dist/glide/index.js"
    },
    "./ioredis": {
      "types": "./dist/ioredis/index.d.ts",
      "default": "./dist/ioredis/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "locks": [
        "./dist/locks/index.d.ts"
      ],
      "idempotency": [
        "./dist/idempotency/index.d.ts"
      ],
      "glide": [
        "./dist/glide/index.d.ts"
      ],
      "ioredis": [
        "./dist/ioredis/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:servers": "node --env-file=docker/servers.env node_modules/vitest/vitest.mjs run --project servers --project servers-exclusive",
    "test:consumers": "pnpm build && node --env-file=docker/servers.env node_modules/vitest/vitest.mjs run --project consumers",
    "test:chaos": "NVK_CHAOS=1 node --env-file=docker/servers.env node_modules/vitest/vitest.mjs run --project chaos --reporter=verbose",
    "check:package": "pnpm build && publint --strict --pack npm && attw --pack . --profile esm-only && node scripts/check-tarball.mjs",
    "servers:up": "docker compose -f docker/compose.yml up -d --wait",
    "servers:down": "docker compose -f docker/compose.yml --profile redis down --volumes --remove-orphans",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:body": "node scripts/release.mjs body",
    "release:check": "node scripts/release.mjs check"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/idempotency": ">=0.0.2 <0.1.0",
    "@nestjs/locks": ">=0.0.3 <0.1.0",
    "@valkey/valkey-glide": "^2.0.1"
  },
  "peerDependenciesMeta": {
    "@nestjs/idempotency": {
      "optional": true
    },
    "@nestjs/locks": {
      "optional": true
    },
    "@valkey/valkey-glide": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/idempotency": "0.0.2",
    "@nestjs/locks": "0.0.4",
    "@nestjs/platform-express": "^12.2.0",
    "@types/node": "^22.20.5",
    "@valkey/valkey-glide": "^2.5.3",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "fast-check": "^4.10.2",
    "ioredis": "6.0.0",
    "ioredis5": "npm:ioredis@^5.11.1",
    "iovalkey": "0.4.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
