# Where `pnpm servers:up` starts the test servers. The test scripts load this file with
# `node --env-file`, which never overrides a variable the environment already sets.
VALKEY_URL=redis://127.0.0.1:16379
VALKEY_SCRATCH_URL=redis://127.0.0.1:16381
VALKEY_CLUSTER_SEEDS=127.0.0.1:17101,127.0.0.1:17102,127.0.0.1:17103
VALKEY_SENTINEL=127.0.0.1:17203/nvk
