{
  // "module": "commonjs" with no moduleResolution: TypeScript 5.9 resolves as node10, which reads
  // no "exports" map, so the subpaths resolve through the package's typesVersions.
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"]
}
